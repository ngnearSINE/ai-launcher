{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Launcher",
  "mainBinaryName": "ai-launcher",
  "version": "0.1.0",
  "identifier": "dev.ngnear.ai-launcher",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI Launcher",
        "width": 1080,
        "height": 720,
        "minWidth": 640,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "ngnear",
    "copyright": "© 2026 Leonard",
    "category": "Utility",
    "shortDescription": "Run several accounts of AI desktop apps side by side",
    "longDescription": "AI Launcher starts separate copies of Claude Desktop, Chrome web apps and other Electron apps, each with its own sign-in, its own taskbar button and a usage card.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "depends": ["python3"] }
    }
  }
}
